CC ?= gcc
CWARNINGS := -Wall -Wextra
override CPPFLAGS += -MMD -MP -I include

MODE ?= release
SRCDIR := src
SRCEXT := c
TARGET := run
BUILDDIR := build

ifeq ($(MODE),debug)
	OPTFLAGS := -O0 -g
else
	OPTFLAGS := -O3
endif

SOURCES := $(shell find $(SRCDIR) -type f -name '*.$(SRCEXT)' | sort)
OBJECTS := $(patsubst $(SRCDIR)/%,$(BUILDDIR)/%,$(SOURCES:.$(SRCEXT)=.o))

DEPS := $(OBJECTS:.o=.d)
override CFLAGS += $(OPTFLAGS) $(CWARNINGS)

all: $(TARGET)

$(BUILDDIR)/%.o: $(SRCDIR)/%.$(SRCEXT)
	@printf "[BUILDING]: "
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(TARGET): $(OBJECTS)
	@printf "[LINKING]: "
	$(CC) $^ -o $@

debug:
	@$(MAKE) --no-print-directory clean
	@$(MAKE) --no-print-directory MODE=debug all

clean:
	@printf "[CLEANING]: "
	rm -rf $(BUILDDIR) $(TARGET)

-include $(DEPS)

.PHONY: all clean debug
