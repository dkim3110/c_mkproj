CC ?= gcc
CWARNINGS := -Wall -Wextra
override CPPFLAGS += -MMD -MP -I include

MODE ?= release
SRCDIR := src
TESTDIR := tests
SRCEXT := c

ifeq ($(MODE),debug)
	BUILDDIR := build/debug
	TESTBUILDDIR := build/tests/debug

	TARGET := bin/debug
	TESTTARGET := bin/tester_debug
	OPTFLAGS := -O0 -g -fsanitize=address,undefined
	override LDFLAGS += -fsanitize=address,undefined
else
	BUILDDIR := build/release
	TESTBUILDDIR := build/tests/release

	TARGET := bin/run
	TESTTARGET := bin/tester_release
	OPTFLAGS := -O3 -DNDEBUG
endif

SOURCES := $(shell find $(SRCDIR) -type f -name '*.$(SRCEXT)' | sort)
TESTSOURCES := $(shell find $(TESTDIR) -type f -name '*.$(SRCEXT)' | sort)

OBJECTS := $(patsubst $(SRCDIR)/%,$(BUILDDIR)/%,$(SOURCES:.$(SRCEXT)=.o))
TESTOBJECTS := $(patsubst $(TESTDIR)/%,$(TESTBUILDDIR)/%,$(TESTSOURCES:.$(SRCEXT)=.o))
LIBOBJECTS := $(filter-out $(BUILDDIR)/main.o,$(OBJECTS))

DEPS := $(OBJECTS:.o=.d)
TESTDEPS := $(TESTOBJECTS:.o=.d)
override CFLAGS += $(OPTFLAGS) $(CWARNINGS)

override LDFLAGS += -L lib
LDLIBS +=

all: $(TARGET)

$(BUILDDIR)/%.o: $(SRCDIR)/%.$(SRCEXT)
	@printf "[BUILDING]: "
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(TESTBUILDDIR)/%.o: $(TESTDIR)/%.$(SRCEXT)
	@printf "[BUILDING]: "
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

$(TARGET): $(OBJECTS)
	@printf "[LINKING]: "
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) $^ -o $@ $(LDLIBS)

$(TESTTARGET): $(LIBOBJECTS) $(TESTOBJECTS)
	@printf "[LINKING]: "
	@mkdir -p $(dir $@)
	$(CC) $(LDFLAGS) $^ -o $@ $(LDLIBS)

debug:
	@$(MAKE) --no-print-directory MODE=debug all

clean:
	@printf "[CLEANING]: "
	rm -rf build/ bin/

test:
	@$(MAKE) --no-print-directory MODE=debug test-release

test-release: $(TESTTARGET)
	@printf "[RUNNING]: ./$(TESTTARGET)\n\n"
	@./$(TESTTARGET)

-include $(DEPS)
-include $(TESTDEPS)

.PHONY: all clean debug test test-release
