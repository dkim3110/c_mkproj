CC ?= gcc
TARGET := run
SRCEXT := c
CWARNINGS := -Wall -Wextra
CFLAGS := -O3

all:
	@$(MAKE) --no-print-directory clean
	@$(MAKE) --no-print-directory default

default: $(TARGET)

$(TARGET): *.$(SRCEXT)
	@printf "[BUILDING]: "
	$(CC) $(CFLAGS) $(CWARNINGS) $^ -o $@

debug:
	@$(MAKE) --no-print-directory clean
	@$(MAKE) --no-print-directory CFLAGS="-O0 -g" all

clean:
	@printf "[CLEANING]: "
	$(RM) $(TARGET)

.PHONY: all clean debug default
