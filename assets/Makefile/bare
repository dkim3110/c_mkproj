CC := gcc
TARGET := run
SRCEXT := c
CFLAGS := -O1 -Wall -Wextra -std=c23

all: $(TARGET)

$(TARGET): *.$(SRCEXT)
	@echo " Building..."
	@$(CC) $(CFLAGS) $^ -o $@

debug:
	@$(MAKE) clean
	@$(MAKE) CFLAGS="$(CFLAGS) -g" all

clean:
	@echo " Cleaning..."
	@$(RM) $(TARGET)

.PHONY: all clean debug
