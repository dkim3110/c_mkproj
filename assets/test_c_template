#include <assert.h>
#include <stdbool.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define TEST_SUCCESS (true)
#define TEST_FAILURE (false)

#define SECONDS		 (1)
#define SEC_SYMBOL "s"

#define MILLISECONDS		(1e3)
#define MILLISEC_SYMBOL "ms"

#define MICROSECONDS		(1e6)
#define MICROSEC_SYMBOL "μs"

#define NANOSECONDS		 (1e9)
#define NANOSEC_SYMBOL "ns"

static inline double delta_time(struct timespec start, struct timespec end, double unit) {
	double start_sec = (double)start.tv_sec + (start.tv_nsec * 1e-9);
	double end_sec = (double)end.tv_sec + (end.tv_nsec * 1e-9);
	double elapsed_sec = end_sec - start_sec;

	return elapsed_sec * unit;
}

static inline void print_error(const char *message) {
	fputs("\n  -error: ", stderr);
	fputs(message, stderr);
	fputs("\n\n", stderr);
}

static bool test_runner(bool (*test_function)(), const char *function_name) {
	fprintf(stderr, "Testing function [%s]: ", function_name);

	struct timespec start, end;
	clock_gettime(CLOCK_MONOTONIC, &start);
	assert(test_function());
	clock_gettime(CLOCK_MONOTONIC, &end);

	fprintf(stderr, "SUCCESS - finished in %07.3f%s\n", delta_time(start, end, MICROSECONDS), MICROSEC_SYMBOL);
	return TEST_SUCCESS;
}

// == TESTS ===================================================================

static bool dummy_test() {
	if (1 + 2 == 3) {
		print_error("test failed!");
		return TEST_FAILURE;
	}

	return TEST_SUCCESS;
}

// =================================================================== TESTS ==

int main(void) {
	struct timespec start, end;
	clock_gettime(CLOCK_MONOTONIC, &start);

	test_runner(dummy_test, "dummy_test()");

	clock_gettime(CLOCK_MONOTONIC, &end);
	fputs("\n All tests passed.\n", stderr);
	fprintf(stderr, "Time elapsed: %06.3f%s\n", delta_time(start, end, MILLISECONDS), MILLISEC_SYMBOL);
	exit(EXIT_SUCCESS);
}
