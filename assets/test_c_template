#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <time.h>

// == FRAMEWORK ===============================================================

static int g_tests_run = 0;
static int g_tests_failed = 0;
static int g_checks_failed = 0;

#define TEST_LOG_FAILURE(...)                                                                                          \
  do {                                                                                                                 \
    g_checks_failed++;                                                                                                 \
    fprintf(stderr, "\n\t%s:%d: ", __FILE__, __LINE__);                                                                \
    fprintf(stderr, __VA_ARGS__);                                                                                      \
  } while (0)

#ifndef TEST_ASSERT
#define TEST_ASSERT(condition)                                                                                         \
  do {                                                                                                                 \
    if (!(condition)) TEST_LOG_FAILURE("TEST_ASSERT failed: '%s'", #condition);                                        \
  } while (0)
#endif // TEST_ASSERT

static inline double time_elapsed(struct timespec start, struct timespec end) {
  return ((double)(end.tv_sec - start.tv_sec) * 1e6) + ((double)(end.tv_nsec - start.tv_nsec) / 1e3);
}

static inline void test_runner(const char *name, void (*test_function)(void)) {
  g_checks_failed = 0;
  fprintf(stderr, "[TEST] %s", name);
  test_function();

  g_tests_run++;
  if (g_checks_failed > 0) {
    g_tests_failed++;
    fprintf(stderr, "\n[FAIL] %s (%d failed check%s)\n", name, g_checks_failed, (g_checks_failed == 1) ? "" : "s");
  } else fprintf(stderr, "\n[PASS] %s\n\n", name);
}

// =============================================================== FRAMEWORK ==

// == TEST LIST ===============================================================

#define TESTS(X)                                                                                                       \
  X(dummy_success)                                                                                                     \
  X(dummy_failure)

#define TEST_DECLARE(name) static void name(void);
TESTS(TEST_DECLARE)

// =============================================================== TEST LIST ==

// == TESTS ===================================================================

static inline void dummy_success(void) {
  TEST_ASSERT(2 + 2 == 4);
}

static inline void dummy_failure(void) {
  TEST_ASSERT(1 + 2 != 3);
}

// =================================================================== TESTS ==

// == MAIN ====================================================================
#define test_runner(name) test_runner(#name, name);

int main(void) {
  struct timespec start, end;

  timespec_get(&start, TIME_UTC);
  TESTS(test_runner)
  timespec_get(&end, TIME_UTC);

  fprintf(stderr,
          "\n%d tests: %d passed, %d failed (%06.3f ms)\n\n",
          g_tests_run,
          g_tests_run - g_tests_failed,
          g_tests_failed,
          time_elapsed(start, end) / 1e3);

  return (g_tests_failed == 0) ? EXIT_SUCCESS : EXIT_FAILURE;
} /* main() */
// ==================================================================== MAIN ==
