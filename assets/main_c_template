#include "main.h"

#include <stdio.h>
#include <stdlib.h>

void error_exit(const char *prog, const char *msg) {
  fprintf(stderr, "%s: %s\n", prog, msg);
  exit(EXIT_FAILURE);
}

void perror_exit(const char *prog, const char *msg) {
  fprintf(stderr, "%s: ", prog);
  perror(msg);
  exit(EXIT_FAILURE);
}

int main(int argc, char *argv[]) {
	perror_exit(argv[0], "Hello, World!");
}
