#ifndef MAIN_H_
#define MAIN_H_

#define error_exit(prog, fmt, ...)                                                                                               \
  do {                                                                                                                           \
    fprintf(stderr, "%s: " fmt "\n", (prog), ##__VA_ARGS__);                                                                     \
    exit(EXIT_FAILURE);                                                                                                          \
  } while (0)

#define perror_exit(prog, fmt, ...)                                                                                              \
  do {                                                                                                                           \
    fprintf(stderr, "%s: " fmt " ", (prog), ##__VA_ARGS__);                                                                      \
    perror("\b");                                                                                                                \
    exit(EXIT_FAILURE);                                                                                                          \
  } while (0)

#endif // MAIN_H_
