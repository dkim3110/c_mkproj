#ifndef MAIN_H_
#define MAIN_H_

#include <errno.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define error_exit(prog, fmt, ...)                                                                                               \
  do {                                                                                                                           \
    fprintf(stderr, "%s: " fmt "\n", (prog)__VA_OPT__(, ) __VA_ARGS__);                                                         \
    exit(EXIT_FAILURE);                                                                                                          \
  } while (0)

#define perror_exit(prog, fmt, ...)                                                                                              \
  do {                                                                                                                           \
    int perror_exit__saved_errno = errno;                                                                                        \
    fprintf(stderr, "%s: " fmt ": %s\n", (prog), __VA_OPT__(__VA_ARGS__, ) strerror(perror_exit__saved_errno));                  \
    exit(EXIT_FAILURE);                                                                                                          \
  } while (0)

#endif // MAIN_H_
